<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Nền đen để chuyển tiếp mượt sang custom SplashScreen composable -->
        <item name="windowSplashScreenBackground">@android:color/black</item>

        <!-- Dùng app icon (sẽ được thay bằng logo custom sau) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>

        <!-- Chuyển sang theme chính sau khi system splash kết thúc -->
        <item name="postSplashScreenTheme">@style/Theme.SmartClick</item>
    </style>
</resources>
